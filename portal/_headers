# Cloudflare Pages reads this file from the root of the site; scripts/build-portal.mts copies it there.
#
# Revalidate every file on every load. The engine's modules are not fingerprinted (assets/viewer.js is the same URL on
# every deploy), and Pages' default for a static file is a four-hour browser cache with no check in between. A
# visitor who opened the site in the four hours before a deploy then ran the NEW page against OLD modules from their
# cache, and the player stopped with "This home could not be opened" ('./assets/shot-track.js' does not provide an
# export named 'trackView'). With max-age=0 and must-revalidate the browser asks every time and the files carry ETags,
# so an unchanged module costs one empty 304.
#
# If a file is ever given a content hash in its name, that file (and only that one) can be cached for a long time.
# The security headers share the block. frame-ancestors is the only directive of the Content-Security-Policy: it keeps another site from
# putting this one in a frame (clickjacking) and leaves scripts, styles and requests alone, so the deploy-time Google Analytics
# snippet (googletagmanager.com, google-analytics.com) and the player's own scripts run exactly as before; the company's own sites
# may still embed it. The Permissions-Policy turns off what no page here uses. nosniff and the Referrer-Policy are Pages' defaults,
# repeated so they stay if the default changes.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: frame-ancestors 'self' https://ci.computer https://*.ci.computer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The pages.dev addresses (the production alias and every pull request's preview) are for the team, not for a search engine: they serve
# the same pages as homes.ci.computer, and a preview's canonical is its own address, so an indexed one would be a duplicate of the real site.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
