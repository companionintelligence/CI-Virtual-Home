#!/usr/bin/env -S node --experimental-strip-types
// Measures every planting species on the geometry the site kit draws and (re)writes assets/site-species-masks.ts:
// the top-down silhouette of each species (what it hides of the mulch under it), which the planting generator
// (assets/site-planting.ts) fills its beds by and the bare-mulch test measures against.
//
//   node --experimental-strip-types scripts/measure-species.mts            print the table
//   node --experimental-strip-types scripts/measure-species.mts --write    rewrite assets/site-species-masks.ts
//
// Run `pnpm run build` first (it measures the compiled assets), and again after --write. A change to a species'
// geometry (assets/site-species.ts, the flower heads and grass tuft in assets/site.ts) needs --write, and the
// species test (scripts/test-site-species.mts) fails until it is done.
import fs from 'node:fs';
import path from 'node:path';
import { measureSpecies, encodeMask, ROOT, MASK_N, MASK_REACH } from './site-species-lib.mts';

if (!fs.existsSync(path.join(ROOT, 'assets', 'site.js'))) { console.error('assets/site.js is missing: pnpm run build first'); process.exit(2); }
const stats = await measureSpecies();
const rows = Object.entries(stats).sort((a, b) => a[1].cover - b[1].cover);
console.table(rows.map(([sp, s]) => ({ species: sp, draw: s.draw, tris: s.tris, cover: s.cover, h: +s.h.toFixed(2), r: +s.r.toFixed(2) })));
if (process.argv.includes('--write')) {
  const body = Object.entries(stats).filter(([, s]) => s.mask).map(([sp, s]) => `  '${sp}': '${encodeMask(s.mask!)}',`).join('\n');
  const tris = Object.entries(stats).map(([sp, s]) => `  '${sp}': ${s.tris},`).join('\n');
  const src = `// GENERATED by scripts/measure-species.mts --write — do not edit by hand.
//
// What each planting species (assets/site-planting.ts SPECIES) hides of the mulch under it: its top-down silhouette
// — foliage, blooms, stems — measured on the geometry assets/site.ts really draws (trees, whose crowns hide what is under
// them anyway, have none), as a ${MASK_N} × ${MASK_N} bit mask over
// [−${MASK_REACH}, ${MASK_REACH}]² in crown radii (a plant's planning \`r\`), row by row, 4 cells a hex character. The planting generator
// stamps these to see where mulch still shows; scripts/test-site-species.mts fails when a species' geometry has
// drifted from its mask (re-run the script with --write).
export const MASK_N = ${MASK_N}, MASK_REACH = ${MASK_REACH};
export const MASKS: Record<string, string> = {
${body}
};
// the triangles one plant of each species costs (foliage, blooms, stems), at its mean size
export const TRIS: Record<string, number> = {
${tris}
};
`;
  fs.writeFileSync(path.join(ROOT, 'assets', 'site-species-masks.ts'), src);
  console.log(`wrote assets/site-species-masks.ts (${Object.keys(stats).length} species)`);
}
