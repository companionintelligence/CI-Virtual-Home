// Writes assets/props/baked/<family>.ts: data only (no THREE, no logic), byte-stable. One module per family, one record per model:
// quantised uint16 positions and indices as base64, the box, the nine-slice fits, the registry facts of a new type (params, tags, iso),
// and `sha` = the sha256 of the record's canonical JSON without that field (scripts/bake/canon.mts), the number the manifest's
// `outSha256` repeats and scripts/test-baked.mts recomputes from the committed file.
//
// The module is plain `export const` data, so Node can import it (strip-types) and the page loads the compiled .js.
import fs from 'node:fs';
import path from 'node:path';
import { recordSha } from './canon.mts';

const REPO = path.resolve(import.meta.dirname, '..', '..');
export const BAKED_DIR = path.join(REPO, 'assets', 'props', 'baked');
export const familyConst = (family: string) => 'BAKED_' + family.toUpperCase().replace(/[^A-Z0-9]+/g, '_');
export const familyFile = (family: string) => path.join(BAKED_DIR, family + '.ts');

const HEAD = (family: string, tool: string, script: string) =>
  `// GENERATED by scripts/bake/emit-ts.mts from models/manifest.json (family "${family}"): do not edit, rebake instead\n` +
  `// (node --experimental-strip-types scripts/bake/bake.mts). ${tool}; bake script sha256 ${script.slice(0, 12)}.\n` +
  `// Geometry and role names only: no texture, image or UV of any source pack, no normals (recomputed at runtime), no source file.\n` +
  `// A record's \`sha\` is the sha256 of its canonical JSON without that field; models/manifest.json's outSha256 repeats it.\n`;

/** What of a record ships, in the order it prints; the sha is of exactly this. */
export function ship(r: Record<string, any>): Record<string, any> {
  const out: Record<string, any> = {};
  for (const k of ['v', 'id', 'type', 'action', 'enabled', 'params', 'tags', 'mountY', 'surface', 'box', 'fit', 'scaleRange', 'iso']) if (r[k] !== undefined) out[k] = r[k];
  out.parts = (r.parts as any[]).map(p => { const o: Record<string, any> = {}; for (const k of ['role', 'cp', 'n', 'nv', 'iw', 'bb', 'pos', 'idx']) if (p[k] !== undefined) o[k] = p[k]; return o; });
  return out;
}

/** Records in, module text out. The key order of a record is fixed here, so the same record always prints the same bytes. */
export function emitFamily(family: string, records: Array<Record<string, any>>, tool: string, script: string): string {
  const sorted = [...records].sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
  const body = sorted.map(r => {
    const shipped = ship(r);
    const sha = recordSha(shipped);
    const lines = ['  ' + JSON.stringify(r.id) + ': {', '    v: ' + JSON.stringify(shipped.v) + ',', '    sha: ' + JSON.stringify(sha) + ','];
    for (const [k, v] of Object.entries(shipped)) {
      if (k === 'v') continue;
      if (k === 'parts') { lines.push('    parts: ['); for (const p of v as any[]) lines.push('      ' + JSON.stringify(p) + ','); lines.push('    ],'); }
      else lines.push('    ' + k + ': ' + JSON.stringify(v) + ',');
    }
    lines.push('  },');
    return lines.join('\n');
  });
  return HEAD(family, tool, script) + `export const ${familyConst(family)} = {\n${body.join('\n')}\n} as const;\n`;
}

export function writeFamily(family: string, records: Array<Record<string, any>>, tool: string, script: string): string {
  fs.mkdirSync(BAKED_DIR, { recursive: true });
  const text = emitFamily(family, records, tool, script);
  fs.writeFileSync(familyFile(family), text);
  return text;
}
