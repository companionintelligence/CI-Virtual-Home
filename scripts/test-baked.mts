#!/usr/bin/env -S node --experimental-strip-types
// The baked prop layer's gates (BAKE stream; PLAN 5.4 / 8). Pure Node, no browser: the committed modules (assets/props/baked/*.ts, generated by
// scripts/bake/ from models/manifest.json) against the manifest, the geometry invariants, the runtime contract, the registry install and the
// attribution file. CI cannot rebake (the 22 packs are not in the repo), so what CI holds is "the committed bytes are the baked bytes" (the sha
// the manifest records) plus everything checkable from the bytes; where the sources and Blender are present (this machine) the rebake itself
// runs too: scripts/bake/bake.mts --verify-repro, two Blender runs per model compared with each other and with the committed module.
//
//   A  manifest        schema, packs, roles, ids, source hashes well-formed
//   B  bytes           module sha == recomputed == manifest outSha256; header tool and script digest are current
//   C  geometry        budgets (<= 6 parts, <= 600 triangles unless flagged), decode valid, no NaN / degenerate, floor and pivot, front probe, winding
//   D  no third-party  no image, texture, UV or normal data in any module; only role names and numbers
//   E  fit             default box vs MEASURED (rigid tolerance), the catalog fit lines, nine-slice linearity, range guard, params cover every spec key
//   F  runtime         fresh materials per call, shared immutable geometry, opaque / one-sided / no map, muted fixed roles, colorParam, rng untouched
//   G  install         in place: Map order unchanged, idempotent, procedural kept as fallback, kill switches, per-model off, variants
//   H  attribution     ATTRIBUTION.md equals the regenerated file; every model has its row
//   I  budgets         eager bytes (gzip), module raw size
//   J  seam            ensureBaked exists and every build call site of room-creator.html awaits it
//   K  rebake          when sources + Blender are present (BAKED_REBAKE=0 skips): bake.mts --verify-repro
//
// @check-house node-test
// @check-house quick
//
//   node --experimental-strip-types --test scripts/test-baked.mts      (needs `pnpm run build`; any cwd)
import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import zlib from 'node:zlib';
import { spawnSync } from 'node:child_process';
import * as THREE from '../assets/vendor/three/three.module.min.js';
import { PROPS } from '../assets/props/index.js';
import { MEASURED } from '../assets/props/measured.js';
import { createBuildContext } from '../assets/build-context.js';
import { createMaterialKit } from '../assets/materials.js';
import { ROLES, decodeModel, installBaked, setBakedMode, sizingFor, buildBaked, ensureBaked, bakedMode } from '../assets/props/model-kit.js';
import { BAKED_MODELS } from '../assets/props/baked.js';
import { recordSha, sha256 } from './bake/canon.mts';
import { REPO, readManifest, PACKS } from './bake/lib.mts';
import { generate as generateAttribution } from './bake/attribution.mts';
import { scriptDigest } from './bake/bake.mts';

const manifest = readManifest();
const entries: any[] = manifest.models;
const packs: any[] = JSON.parse(fs.readFileSync(PACKS, 'utf8')).packs;
const byId = (id: string) => BAKED_MODELS.find(m => m.id === id)!;
const text = (rel: string) => fs.readFileSync(path.join(REPO, rel), 'utf8');
const RIGID_TOL = 0.01, Y_TOL = 0.12;

// ---- a build context like the page's ----------------------------------------------------------------------------------------
const bc = createBuildContext({ THREE } as any);
const kit = createMaterialKit({ THREE, palette: { wall: '#f1f5f9', trim: '#1e293b', accent: '#0f766e', material: 'stucco' }, seed: 'test-baked' } as any);
const mixC = (a: any, b: any, t: number) => { const A = bc.hex(a), B = bc.hex(b); const f = (s: number) => Math.round(((A >> s) & 255) * (1 - t) + ((B >> s) & 255) * t); return (f(16) << 16) | (f(8) << 8) | f(0); };
const ctxFor = (key = 'x', counter?: { n: number }) => { const r = kit.itemRng(key); return { THREE, std: bc.std, box: bc.box, group: bc.group, mix: mixC, hex: bc.hex, colors: kit.colors, rng: counter ? () => { counter.n++; return r(); } : r }; };
const build = (type: string, it: any = {}, key = 'x') => { const o = PROPS.get(type).create({ type, at: [0, 0], ...it }, ctxFor(key)); o.updateMatrixWorld(true); return o; };
const boxOf = (o: any) => new THREE.Box3().setFromObject(o);
const meshesOf = (o: any) => { const l: any[] = []; o.traverse((m: any) => { if (m.isMesh) l.push(m); }); return l; };

test.beforeEach(() => setBakedMode(null));
test.after(() => setBakedMode(null));

// ---- A. manifest ----------------------------------------------------------------------------------------------------------
test('A: the manifest is well formed and every entry points at a real pack, role and module', () => {
  assert.equal(manifest.schema, 1);
  assert.ok(entries.length >= 3, 'the three pilots');
  const ids = new Set<string>();
  for (const e of entries) {
    assert.ok(/^[a-z0-9-]+$/.test(e.id), `id ${e.id}`); assert.ok(!ids.has(e.id), `duplicate id ${e.id}`); ids.add(e.id);
    assert.ok(/^[a-z0-9-]+$/.test(e.family), `${e.id}: family`);
    assert.ok(['add', 'replace'].includes(e.action), `${e.id}: action`);
    assert.equal(typeof e.enabled, 'boolean', `${e.id}: enabled is the explicit removal switch`);
    if (e.action === 'replace') assert.equal(e.enabled, false, `${e.id}: a replace model stays disabled until the owner look and the re-bless (PLAN B4)`);
    const p = packs.find(q => q.id === e.src.pack);
    assert.ok(p, `${e.id}: pack ${e.src.pack} is not in models/packs.json`);
    assert.equal(p.decision, 'use', `${e.id}: nothing ships from a "${p.decision}" pack`);
    assert.ok(/^[0-9a-f]{64}$/.test(e.src.sha256), `${e.id}: source sha256`);
    assert.ok(e.src.file.startsWith(p.folder + '/'), `${e.id}: src.file is inside the pack folder`);
    assert.ok(e.src.objects.length >= 1);
    assert.ok(fs.existsSync(path.join(REPO, 'assets/props/baked', e.family + '.ts')), `${e.id}: baked/${e.family}.ts`);
    assert.ok(!e.colorParam || ROLES[e.colorParam], `${e.id}: colorParam role`);
    assert.ok(e.outSha256 && e.stats && Array.isArray(e.changes), `${e.id}: not baked yet`);
  }
  assert.equal(BAKED_MODELS.length, entries.length, 'every manifest entry has a record, and every record an entry');
});

// ---- B. bytes -----------------------------------------------------------------------------------------------------------------
test('B: the committed bytes are the baked bytes (sha), and the header names the current tool and bake script', () => {
  for (const e of entries) {
    const m: any = byId(e.id);
    assert.ok(m, `${e.id}: no record`);
    assert.equal(recordSha(m), m.sha, `${e.id}: the record does not hash to its own sha: the module was edited by hand`);
    assert.equal(m.sha, e.outSha256, `${e.id}: the module and the manifest's outSha256 disagree: rebake`);
    const head = text(`assets/props/baked/${e.family}.ts`).split('\n').slice(0, 2).join('\n');
    assert.ok(head.includes(`blender ${manifest.tool.blender} (build ${manifest.tool.hash})`), `${e.family}: header tool is not the pinned Blender`);
    assert.ok(head.includes(`bake script sha256 ${manifest.tool.script.slice(0, 12)}`), `${e.family}: header script digest is not the manifest's`);
  }
  assert.equal(manifest.tool.script, scriptDigest(), 'scripts/bake/blender_bake.py changed since the last bake: rebake (node --experimental-strip-types scripts/bake/bake.mts)');
});

// ---- C. geometry ------------------------------------------------------------------------------------------------------------
const verts = (m: any) => decodeModel(m).map(d => d.pos);
/** Closedness and signed volume of one part after welding the split vertices back together (positions to 0.1 mm). */
function shellOf(m: any, i: number) {
  const d = decodeModel(m)[i], key = (a: number) => [0, 1, 2].map(k => Math.round(d.pos[a * 3 + k] / 1e-4)).join(',');
  const edges = new Map<string, number>(); let vol = 0; const T = d.idx.length / 3;
  for (let t = 0; t < T; t++) {
    const a = d.idx[t * 3], b = d.idx[t * 3 + 1], c = d.idx[t * 3 + 2];
    for (const [u, v] of [[a, b], [b, c], [c, a]]) { const k = key(u) + '>' + key(v); edges.set(k, (edges.get(k) || 0) + 1); }
    const P = [a, b, c].map(v => [d.pos[v * 3], d.pos[v * 3 + 1], d.pos[v * 3 + 2]]);
    vol += (P[0][0] * (P[1][1] * P[2][2] - P[1][2] * P[2][1]) - P[0][1] * (P[1][0] * P[2][2] - P[1][2] * P[2][0]) + P[0][2] * (P[1][0] * P[2][1] - P[1][1] * P[2][0])) / 6;
  }
  let open = 0;
  for (const [k, n] of edges) { const [u, v] = k.split('>'); if (n !== 1 || edges.get(v + '>' + u) !== 1) open++; }
  return { closed: open === 0, open, vol };
}
test('C: budgets, valid decode, floor and pivot, front, winding', () => {
  for (const e of entries) {
    const m: any = byId(e.id), dec = decodeModel(m), budget = e.budget || {};
    assert.ok(m.parts.length >= 1 && m.parts.length <= (budget.parts || 6), `${e.id}: ${m.parts.length} parts (at most ${budget.parts || 6})`);
    const tris = m.parts.reduce((a: number, p: any) => a + p.n, 0);
    assert.ok(tris <= 600 || (budget.over600 && tris <= 1500), `${e.id}: ${tris} triangles: over 600 needs budget.over600 and stays under 1500`);
    assert.ok(tris <= (budget.tris || 600), `${e.id}: ${tris} triangles over its own budget ${budget.tris}`);
    assert.equal(tris, e.stats.tris, `${e.id}: stats.tris is stale`);
    let lo = [1e9, 1e9, 1e9], hi = [-1e9, -1e9, -1e9];
    dec.forEach((d, pi) => {
      const p = m.parts[pi];
      assert.equal(d.pos.length, p.nv * 3, `${e.id}/${p.role}: vertex count`);
      assert.equal(d.idx.length, p.n * 3, `${e.id}/${p.role}: index count`);
      for (const v of d.pos) assert.ok(Number.isFinite(v), `${e.id}/${p.role}: NaN position`);
      for (const i of d.idx) assert.ok(i < p.nv, `${e.id}/${p.role}: index ${i} out of range ${p.nv}`);
      for (let t = 0; t < p.n; t++) {
        const [a, b, c] = [d.idx[t * 3], d.idx[t * 3 + 1], d.idx[t * 3 + 2]].map(i => [d.pos[i * 3], d.pos[i * 3 + 1], d.pos[i * 3 + 2]]);
        const u = [b[0] - a[0], b[1] - a[1], b[2] - a[2]], w = [c[0] - a[0], c[1] - a[1], c[2] - a[2]];
        const n = [u[1] * w[2] - u[2] * w[1], u[2] * w[0] - u[0] * w[2], u[0] * w[1] - u[1] * w[0]];
        assert.ok(n[0] * n[0] + n[1] * n[1] + n[2] * n[2] > 1e-14, `${e.id}/${p.role}: degenerate triangle ${t}`);
      }
      for (let i = 0; i < d.pos.length; i += 3) for (let k = 0; k < 3; k++) { lo[k] = Math.min(lo[k], d.pos[i + k]); hi[k] = Math.max(hi[k], d.pos[i + k]); }
      // shells: a closed part has positive volume; an open one is only allowed when the entry signs it off
      const s = shellOf(m, pi);
      if (s.closed) assert.ok(s.vol > 0, `${e.id}/${p.role}: closed shell with volume ${s.vol}: inverted winding`);
      else assert.ok((e.open || []).includes(p.role), `${e.id}/${p.role}: ${s.open} open edges and the entry does not list the role under "open"`);
    });
    for (let k = 0; k < 3; k++) { assert.ok(Math.abs(lo[k] - m.box[k]) < 2e-3 && Math.abs(hi[k] - m.box[3 + k]) < 2e-3, `${e.id}: box does not match the vertices on axis ${k}`); }
    const pivot = (e.pose && e.pose.pivot) || 'floor-centre';
    if (pivot !== 'ceiling') assert.ok(Math.abs(lo[1]) < 1e-3, `${e.id}: y-min ${lo[1]} (the floor is y = 0)`);
    if (pivot === 'wall-back') assert.ok(Math.abs(lo[2]) < 1e-3, `${e.id}: wall-back pivot but z-min is ${lo[2]}`);
    if (pivot === 'floor-centre') { assert.ok(Math.abs((lo[0] + hi[0]) / 2) < 0.03 && Math.abs((lo[2] + hi[2]) / 2) < 0.03, `${e.id}: floor-centre pivot off the box centre`); }
    // the front is +z: a probe per entry
    const probe = e.frontProbe;
    assert.ok(probe, `${e.id}: frontProbe is required ("none" with a reason in "pilot" for a symmetric piece)`);
    const meanZ = (sel: (r: string) => boolean) => { let s = 0, n = 0; dec.forEach((d, pi) => { if (!sel(m.parts[pi].role)) return; for (let i = 2; i < d.pos.length; i += 3) { s += d.pos[i]; n++; } }); return s / n; };
    if (probe.startsWith('frontRole:')) assert.ok(meanZ(r => r === probe.slice(10)) > meanZ(() => true) + 0.005, `${e.id}: the ${probe.slice(10)} part is not toward +z: the front axis is wrong`);
    else if (probe === 'backIsTall') { const zs: Array<[number, number]> = []; dec.forEach(d => { for (let i = 0; i < d.pos.length; i += 3) zs.push([d.pos[i + 1], d.pos[i + 2]]); }); zs.sort((a, b) => b[0] - a[0]); const top = zs.slice(0, Math.ceil(zs.length * 0.3)); assert.ok(top.reduce((a, v) => a + v[1], 0) / top.length < zs.reduce((a, v) => a + v[1], 0) / zs.length, `${e.id}: the tall part is not at the back`); }
    else assert.equal(probe, 'none');
    // the per-object winding gate the bake enforced (the only check that reaches objects merged into one part): evidence in stats
    for (const o of e.stats.objects) assert.ok(o.vol > 0 || (e.src.windingExempt || []).includes(o.name), `${e.id}: source object ${o.name} recorded with volume ${o.vol}`);
    void verts;
  }
});
test('C: the winding fix is real: the medicine cabinet flips exactly the mirrored door, and the bake records it', () => {
  const e = entries.find(x => x.id === 'medicine-cabinet-a');
  assert.deepEqual(e.stats.mirroredObjects, ['Bathroom_cabinet_door']);
  const flipped = e.stats.objects.filter((o: any) => o.flipped).map((o: any) => o.name);
  assert.deepEqual(flipped, ['Bathroom_cabinet_door']);
  const door = e.stats.objects.find((o: any) => o.name === 'Bathroom_cabinet_door'), twin = e.stats.objects.find((o: any) => o.name === 'Bathroom_cabinet_door_01');
  assert.ok(door.vol > 0 && Math.abs(door.vol - twin.vol) < 1e-6, `the flipped door has its twin's volume (${door.vol} vs ${twin.vol})`);
});

// ---- D. no third-party bytes -------------------------------------------------------------------------------------------------
test('D: a module holds only numbers, role names and base64 geometry: no image, texture, UV or normal data', () => {
  const ALLOWED_REC = new Set(['v', 'sha', 'id', 'type', 'action', 'enabled', 'params', 'tags', 'mountY', 'surface', 'box', 'fit', 'scaleRange', 'iso', 'parts']);
  const ALLOWED_PART = new Set(['role', 'cp', 'n', 'nv', 'iw', 'bb', 'pos', 'idx']);
  for (const e of entries) {
    const src = text(`assets/props/baked/${e.family}.ts`).split('\n').filter(l => !l.startsWith('//')).join('\n');
    assert.ok(!/data:|iVBORw0KGgo|\/9j\/|GIF8[79]a|image\/|\.png|\.jpe?g|\.fbx|\.dae|\.glb|texture|\buv\b|normal/i.test(src.replace(/pos":"[^"]*"|idx":"[^"]*"/g, '')), `${e.family}.ts mentions an image, texture, UV, normal or model file`);
    const m: any = byId(e.id);
    for (const k of Object.keys(m)) assert.ok(ALLOWED_REC.has(k), `${e.id}: unexpected record field ${k}`);
    for (const p of m.parts) {
      for (const k of Object.keys(p)) assert.ok(ALLOWED_PART.has(k), `${e.id}: unexpected part field ${k}`);
      assert.ok(ROLES[p.role], `${e.id}: unknown role ${p.role}`);
      const bin = Buffer.from(p.pos, 'base64');
      assert.equal(bin.length, p.nv * 6, `${e.id}/${p.role}: pos is nv x 3 x uint16 and nothing else`);
      assert.equal(Buffer.from(p.idx, 'base64').length, p.n * 3 * p.iw, `${e.id}/${p.role}: idx is n x 3 indices and nothing else`);
      for (const sig of [Buffer.from([0x89, 0x50, 0x4e, 0x47]), Buffer.from([0xff, 0xd8, 0xff]), Buffer.from('DDS '), Buffer.from('glTF'), Buffer.from('Kaydara')]) assert.ok(bin.indexOf(sig) !== 0, `${e.id}: geometry bytes start with a file signature`);
    }
  }
});

// ---- E. fit ---------------------------------------------------------------------------------------------------------------------
const extents = (b: number[]) => [b[3] - b[0], b[4] - b[1], b[5] - b[2]];
test('E: the default box matches the measured box (replace) or the catalog row (add), and the fit lines are the nine-slice', () => {
  for (const e of entries) {
    const m: any = byId(e.id), M = (MEASURED as any)[e.prop_type];
    assert.ok(M, `${e.id}: no measured row for ${e.prop_type}: run pnpm run catalog and commit its appended row`);
    const mb = [M.b[0], M.y[0], M.b[1], M.b[2], M.y[1], M.b[3]], me = extents(mb), be = extents(m.box);
    if (e.action === 'replace') {
      const tol = e.parityTol || RIGID_TOL;
      assert.ok(Math.abs(be[0] - me[0]) <= tol && Math.abs(be[2] - me[2]) <= tol, `${e.id}: footprint ${be[0].toFixed(3)} x ${be[2].toFixed(3)} vs measured ${me[0].toFixed(3)} x ${me[2].toFixed(3)} (tolerance ${tol})`);
      assert.ok(Math.abs(be[1] / me[1] - 1) <= Y_TOL, `${e.id}: height ${be[1].toFixed(3)} vs measured ${me[1].toFixed(3)} (within ${Y_TOL * 100}%)`);
      assert.ok(tol === RIGID_TOL || e.parityNote, `${e.id}: a parity tolerance above ${RIGID_TOL} needs a parityNote`);
    } else {
      for (let k = 0; k < 6; k++) assert.ok(Math.abs(mb[k] - m.box[k]) <= 0.002, `${e.id}: catalog box is stale on coordinate ${k} (${mb[k]} vs ${m.box[k]}): pnpm run catalog`);
      assert.ok(PROPS.get(e.prop_type).footprint[0] > 0);
    }
    if (m.fit) for (const [param, f] of Object.entries(m.fit) as any) {
      assert.ok(e.params.includes(param), `${e.id}: fit.${param} without the param`);
      assert.ok(f.range[0] <= f.native * 0.75 && f.range[1] >= f.native * 1.35, `${e.id}: fit.${param} range does not cover the catalog's probes`);
      const line = M.fit && M.fit[param] && M.fit[param][f.axis];
      if (e.action === 'add') { assert.ok(line, `${e.id}: the catalog recorded no fit line for ${param}`); assert.ok(Math.abs(line[0] - 1) < 0.01, `${e.id}: fit slope ${line[0]} (a nine-slice is exactly linear)`); }
      // exact linearity: the box grows by exactly the size change, at the ends of the range too
      for (const v of [f.range[0], f.native * 0.9, f.native * 1.2, f.range[1]]) {
        const bb = boxOf(buildBaked(m, { [param]: v }, ctxFor(), true)), ax = f.axis === 'x' ? 0 : f.axis === 'y' ? 1 : 2;
        assert.ok(Math.abs(bb.max.toArray()[ax] - bb.min.toArray()[ax] - v) < 2e-3, `${e.id}: ${param}=${v} built ${(bb.max.toArray()[ax] - bb.min.toArray()[ax]).toFixed(4)}`);
      }
    }
  }
});
test('E: params cover every key a spec uses for the type (no new silent-param), and out-of-range items are pinned', () => {
  const COMMON = new Set(['type', 'at', 'rot', 'y', 'id', 'note', '$comment', 'src', 'name', 'label', 'lock']);
  const specs = [...fs.readdirSync(path.join(REPO, 'content/houses')).filter(f => f.endsWith('.json') && f !== 'index.json' && !f.endsWith('.plan.json')).map(f => 'content/houses/' + f),
    ...fs.readdirSync(path.join(REPO, 'test/fixtures/houses')).filter(f => f.endsWith('.json')).map(f => 'test/fixtures/houses/' + f)];
  const outside: Record<string, number> = {};
  for (const f of specs) {
    const walk = (o: any) => { if (Array.isArray(o)) o.forEach(walk); else if (o && typeof o === 'object') { const e = entries.find(x => x.prop_type === o.type && Array.isArray(o.at)); if (e) { const m: any = byId(e.id); for (const k of Object.keys(o)) if (!COMMON.has(k)) assert.ok(PROPS.get(e.prop_type).params.includes(k), `${f}: ${e.prop_type} uses "${k}", which the baked layer does not honour (silent-param)`); if (e.action === 'replace' && !sizingFor(m, o, false)) outside[e.id] = (outside[e.id] || 0) + 1; } Object.values(o).forEach(walk); } };
    walk(JSON.parse(text(f)));
  }
  for (const e of entries) assert.equal(outside[e.id] || 0, e.rangeFallbacks || 0, `${e.id}: the number of spec items outside the nine-slice range changed (pinned in the manifest as rangeFallbacks)`);
});

// ---- F. runtime ----------------------------------------------------------------------------------------------------------------
test('F: materials are fresh per call and plain, geometry is shared and immutable, an item draws no rng', () => {
  setBakedMode('all');
  for (const e of entries) {
    const m: any = byId(e.id), a = build(e.prop_type, { color: undefined }), b = build(e.prop_type);
    const ma = meshesOf(a), mb = meshesOf(b);
    assert.equal(ma.length, m.parts.length, `${e.id}: one mesh per part`);
    assert.ok(ma.length <= 6);
    ma.forEach((mesh, i) => {
      const mat = mesh.material, p = m.parts[i];
      assert.notStrictEqual(mat, mb[i].material, `${e.id}: a material was shared between two create() calls`);
      assert.strictEqual(mesh.geometry, mb[i].geometry, `${e.id}: geometry is shared between two creates of the same size`);
      assert.ok(!mat.map && !mat.alphaMap && !mat.normalMap && !mat.transparent && mat.opacity === 1 && mat.side === THREE.FrontSide, `${e.id}/${p.role}: opaque, one-sided, no map`);
      assert.equal(mat.name, 'role:' + p.role);
      assert.ok(mesh.castShadow && mesh.receiveShadow);
      assert.equal(!!mat.userData.muted, ROLES[p.role].fixed !== undefined, `${e.id}/${p.role}: fixed literals are muted, house roles are not`);
      assert.equal(!!mat.userData.colorParam, !!p.cp);
      assert.ok(!mesh.geometry.attributes.uv && !mesh.geometry.attributes.color, `${e.id}: no UVs, no vertex colours`);
      assert.ok(mesh.geometry.attributes.normal, 'normals are computed at build');
    });
    assert.equal(a.userData.bakedId, e.id);
    const c = { n: 0 }; PROPS.get(e.prop_type).create({ type: e.prop_type, at: [0, 0] }, ctxFor('x', c)); assert.equal(c.n, 0, `${e.id}: a baked prop draws no rng`);
    const pa = meshesOf(a).map(x => Array.from(x.geometry.attributes.position.array as Float32Array)), pb = meshesOf(b).map(x => Array.from(x.geometry.attributes.position.array as Float32Array));
    assert.deepEqual(pa, pb, `${e.id}: two builds differ`);
  }
});
test('F: the colorParam part takes the spec colour and nothing else does; house roles come from the kit', () => {
  setBakedMode('all');
  const e = entries.find(x => x.colorParam)!, m: any = byId(e.id);
  const o = build(e.prop_type, { color: '#ff0000' });
  meshesOf(o).forEach((mesh, i) => { const p = m.parts[i]; if (p.cp) assert.equal(mesh.material.color.getHex(), 0xff0000); else if (ROLES[p.role].from) assert.equal(mesh.material.color.getHex(), kit.colors[ROLES[p.role].from!], `${p.role} takes the house colour`); });
});

// ---- G. install -----------------------------------------------------------------------------------------------------------------
const fakeRegistry = () => {
  const reg = new Map<string, any>();
  for (const k of ['aaa', 'nightstand', 'zzz']) reg.set(k, { footprint: [0.5, 0.4], height: 0.55, params: ['color'], tags: [], create: (it: any, ctx: any) => { const g = ctx.group('procedural'); g.userData.procedural = true; return g; } });
  return reg;
};
test('G: a replace model keeps its slot, inherits the definition, falls back to the procedural builder and installs idempotently', () => {
  const reg = fakeRegistry(), before = [...reg.keys()], proc = reg.get('nightstand');
  const model: any = { ...JSON.parse(JSON.stringify(byId('nightstand-a'))), enabled: true };
  installBaked(reg, [model]);
  assert.deepEqual([...reg.keys()], before, 'Map order (catalog order, propTypes()) is untouched');
  const d = reg.get('nightstand');
  assert.equal(d.footprint, proc.footprint); assert.equal(d.params, proc.params); assert.equal(d.height, proc.height);
  assert.ok(d.bakedId === 'nightstand-a' && d.procedural === proc);
  assert.equal(d.create({ type: 'nightstand' }, ctxFor()).userData.bakedId, 'nightstand-a');
  setBakedMode('0'); assert.ok(d.create({ type: 'nightstand' }, ctxFor()).userData.procedural, '?baked=0 serves the procedural prop');
  setBakedMode('1', ['nightstand-a']); assert.ok(d.create({ type: 'nightstand' }, ctxFor()).userData.procedural, 'a model switched off serves the procedural prop');
  setBakedMode(null);
  installBaked(reg, [model]);
  assert.strictEqual(reg.get('nightstand').procedural, proc, 'installing twice does not stack overrides');
  assert.deepEqual([...reg.keys()], before);
});
test('G: out of the nine-slice range a replace model falls back to the procedural builder; an add model clamps', () => {
  const reg = fakeRegistry();
  const model: any = { ...JSON.parse(JSON.stringify(byId('box-carton'))), type: 'nightstand', action: 'replace', enabled: true, id: 'fake-box' };
  installBaked(reg, [model]);
  const d = reg.get('nightstand'), ok = d.create({ type: 'nightstand', w: 0.5 }, ctxFor()), out = d.create({ type: 'nightstand', w: 2.5 }, ctxFor());
  assert.ok(ok.userData.bakedId && !out.userData.bakedId && out.userData.procedural, 'w = 2.5 is outside the range: procedural');
  const clamped = boxOf(build('cardboard-box', { w: 5 })), max = (byId('box-carton') as any).fit.w.range[1];
  assert.ok(Math.abs(clamped.max.x - clamped.min.x - max) < 2e-3, 'an add type clamps to the range');
});
test('G: an add model appends a new type, never replaces a procedural one, and its kill switches leave an empty group', () => {
  const reg = fakeRegistry(), before = [...reg.keys()];
  installBaked(reg, [JSON.parse(JSON.stringify(byId('box-carton')))]);
  assert.deepEqual([...reg.keys()], [...before, 'cardboard-box'], 'appended after everything');
  assert.throws(() => installBaked(reg, [{ ...JSON.parse(JSON.stringify(byId('box-carton'))), type: 'nightstand' }]), /already has it/);
  assert.throws(() => installBaked(reg, [{ ...JSON.parse(JSON.stringify(byId('nightstand-a'))), type: 'no-such-type' }]), /no procedural prop/);
  const g = PROPS.get('cardboard-box'); setBakedMode('0');
  const o = g.create({ type: 'cardboard-box' }, ctxFor()); assert.ok(o.userData.bakedOff && meshesOf(o).length === 0);
  setBakedMode('all', ['box-carton']); assert.ok(g.create({ type: 'cardboard-box' }, ctxFor()).userData.bakedOff);
});
test('G: the real registry: replace models keep their slot, add models come after the categories, modes are what the page reads', () => {
  const keys = [...PROPS.keys()];
  for (const e of entries) { const i = keys.indexOf(e.prop_type); assert.ok(i >= 0); if (e.action === 'add') assert.ok(i >= keys.length - entries.filter(x => x.action === 'add').length, `${e.prop_type} is appended`); else assert.equal(PROPS.get(e.prop_type).bakedId, e.id); }
  assert.equal(bakedMode(), '1');
  (globalThis as any).location = { search: '?baked=0&baked-off=a,b' }; setBakedMode(null);
  try { assert.equal(bakedMode(), '0'); (globalThis as any).location = { search: '?baked=all' }; assert.equal(bakedMode(), 'all'); } finally { delete (globalThis as any).location; }
  // the pilot nightstand is disabled: with the default switches the registry serves exactly the procedural prop
  const ns = build('nightstand'); assert.ok(!ns.userData.bakedId && meshesOf(ns).length === 11, 'default: procedural nightstand');
  setBakedMode('all'); assert.equal(build('nightstand').userData.bakedId, 'nightstand-a');
});
test('G: variants of one type pick by one rng draw from the item\'s own stream', () => {
  const reg = fakeRegistry();
  const a: any = { ...JSON.parse(JSON.stringify(byId('box-carton'))), id: 'v-a', enabled: true }, b: any = { ...a, id: 'v-b', sha: 'x' };
  installBaked(reg, [a, b]);
  const d = reg.get('cardboard-box'), picks = new Set<string>(), c = { n: 0 };
  for (let i = 0; i < 40; i++) { const cc = { n: 0 }; picks.add(d.create({ type: 'cardboard-box' }, ctxFor('k' + i, cc)).userData.bakedId); assert.equal(cc.n, 1, 'exactly one draw'); }
  assert.deepEqual([...picks].sort(), ['v-a', 'v-b']); void c;
});

