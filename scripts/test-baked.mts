test('I: eager data stays inside the budget (PLAN 8.4: wave B1 at most 120 KB gzip, modules at most 400 KB raw)', () => {
  const dir = path.join(REPO, 'assets/props/baked'); let raw = 0, gz = 0;
  for (const f of fs.readdirSync(dir).filter(f => f.endsWith('.ts'))) { const b = fs.readFileSync(path.join(dir, f)); raw += b.length; gz += zlib.gzipSync(b).length; }
  assert.ok(gz <= 120 * 1024, `eager baked data ${gz} bytes gzip`);
  assert.ok(raw <= 400 * 1024, `baked modules ${raw} bytes raw`);
  console.log(`# baked modules: ${raw} bytes raw, ${gz} bytes gzip, ${entries.reduce((a, e) => a + e.stats.tris, 0)} triangles in ${entries.length} models`);
});

