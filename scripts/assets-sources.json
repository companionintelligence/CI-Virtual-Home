  "dropped": [
    {
      "sourceId": "beige_wall_001",
      "why": "a smooth painted wall: its albedo is a flat tone and its normal map nearly flat, so after the luma-only normalisation the swap added nothing and, in an A/B still of the aurora stucco walls, replaced the kit's fine stucco grain with a blank surface. The kit keeps its procedural stucco"
    },
    {
      "sourceId": "mid_century_lounge_chair",
      "why": "dark leather and bent plywood against a kit club chair in oatmeal or white upholstery: the palette tint multiplies the texture, so it cannot lighten a dark one and the chair would break the room palette (judged from the source's materials, not from a render of it in a house)"
    },
    {
      "sourceId": "wooden_display_shelves_01",
      "why": "a tall open wooden shelf (1.08 x 0.37 x 1.56 m, from the source's bounding box) against the kit cube-storage, a 0.76 m low cubby grid in painted colours: it would fail the fit gate, so it was not adopted"
    },
    {
      "sourceId": "potted_plant_04",
      "why": "one potted succulent against the kit succulent-tray, a tray of five plants (0.36 x 0.2 m): no honest fit"
    },
    {
      "sourceId": "wicker_basket_01",
      "why": "a shallow 0.38 x 0.12 m basket against the kit laundry-basket, a 0.6 m hamper with laundry: wrong object"
    },
    {
      "sourceId": "Gravel023",
      "why": "no procedural kind to replace (the swap list is oak, herringbone, concrete, stucco, brick, siding, stone, asphalt, clay-tile, deck, tile)"
    }
  ]
