{
  "$schema": "house-spec/v1",
  "id": "soft-props",
  "name": "SOFT Props Fixture",
  "author": "ci-virtual-home",
  "source": "test fixture (SOFT stream, PLAN 5.3 T14): every soft type the grammar rebuilds or adds, authored by hand and unprogrammed, so a stream proves its props here and not on the 150 goldens",
  "style": "Single-storey gallery of the soft furnishings",
  "emoji": "\ud83e\uddea",
  "fixture": {
    "note": "every soft type, by hand and unprogrammed: ten bed types and six of them again (different instances, so different streams), a quilted bed, three throws laid on beds at the specs' bed heights (y 0.50-0.55, the SOFT wave-3 fix), eight curtains of different widths, the three towel rails and towel-stack, towel-ring-set and robe-hook, the loose soft goods (cushion sets, throws, ottoman, poufs, two bean bags, floor cushions, a bench), eight sofas and sectionals, six armchairs (each twice, one repainted), twenty-two plant types (floor plants at default and other heights, surface plants on consoles, cut flowers, pampas, hanging plants, the dormant trough-planter and pothos) and the five dormant window treatments (roman blind, roller shade, cafe curtain, shutters, valance)."
  },
